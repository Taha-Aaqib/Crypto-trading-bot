# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES
# cp .env.example .env   (macOS/Linux)
# copy .env.example .env (Windows)
#
# ⚠️ NEVER commit .env to git — it contains real API keys!
# ============================================================

# ------------------------------------------------------------
# BINANCE API (Required)
# Get from: https://www.binance.com/en/my/settings/api-management
# Enable: "Enable Futures" permission
# ------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ------------------------------------------------------------
# COINGECKO API (Free — 10,000 calls/month)
# Get from: https://www.coingecko.com/en/developers/dashboard
# ------------------------------------------------------------
COINGECKO_API_KEY=your_coingecko_api_key_here

# ------------------------------------------------------------
# REDDIT API (Optional — used for sentiment analysis)
# Get from: https://www.reddit.com/prefs/apps → Create App
# Choose "script" type
# ------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=crypto_bot/1.0 by your_reddit_username
